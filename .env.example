# Gluetun Control Center - Environment Configuration Template
# NOTE: Secrets must NEVER be committed to version control.

# --- Dashboard HTTP Server ---
# Dashboard bind address (Default: 127.0.0.1:9090 for security; never expose raw on 0.0.0.0 without a reverse proxy/auth)
DASHBOARD_HTTP_ADDRESS=127.0.0.1:9090

# Enable session-based admin authentication and CSRF token protection
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change_this_secure_password_in_production

# Persistence directory for user profiles and audit logs
DASHBOARD_DATA_DIR=/data

# Internal port on your application container that the forwarded port redirects to
DASHBOARD_INTERNAL_PORT=8080

# Comma-separated list of allowed CORS / Origin headers
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:9090

# --- Gluetun VPN Engine Configuration ---
VPN_SERVICE_PROVIDER=protonvpn
# Choose 'openvpn' or 'wireguard'
VPN_TYPE=openvpn

# For OpenVPN (ProtonVPN Manual Connection Credentials):
OPENVPN_USER=
OPENVPN_PASSWORD=

# For WireGuard (optional alternative to OpenVPN):
# WIREGUARD_PRIVATE_KEY=wOEI9rqqbDwnN8/Bpp22sVz48T71vJ4fYmFWujulwUU=

# Server country / location
SERVER_COUNTRIES=India

# Port Forwarding (on/off)
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_PROVIDER=protonvpn
PORT_FORWARD_ONLY=on

# URL of Gluetun's internal control server (Port 8000 must NEVER be exposed publicly)
GLUETUN_CONTROL_URL=http://gluetun:8000

# Optional API key for Gluetun control server (if configured with HTTP_CONTROL_SERVER_AUTH_SECRET)
GLUETUN_CONTROL_API_KEY=

# --- Development Mock Mode ---
# Set to 'true' only for frontend/UI development without a running Gluetun engine container
# When true, a prominent 'DEMO DATA' badge is displayed in the dashboard
GLUETUN_MOCK=false
