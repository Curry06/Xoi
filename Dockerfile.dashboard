# Stage 1: Build React/TypeScript Frontend
FROM node:22-alpine AS frontend-builder
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Stage 2: Build Go Dashboard Binary
FROM golang:1.24-alpine AS backend-builder
WORKDIR /src
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Copy compiled frontend into internal/dashboard/web/dist
COPY --from=frontend-builder /src/internal/dashboard/web/dist ./internal/dashboard/web/dist

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/gluetun-dashboard ./cmd/gluetun-dashboard

# Stage 3: Minimal Production Container
FROM alpine:3.21 AS final
LABEL maintainer="passteque" \
      description="Gluetun Control Center - Production Management Dashboard"

RUN apk add --no-cache ca-certificates tzdata wget && \
    addgroup -S -g 1000 appgroup && \
    adduser -S -u 1000 -G appgroup appuser && \
    mkdir -p /data && \
    chown -R appuser:appgroup /data

COPY --from=backend-builder /bin/gluetun-dashboard /bin/gluetun-dashboard

USER 1000:1000
WORKDIR /home/appuser
VOLUME ["/data"]

EXPOSE 9090

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:9090/api/dashboard/status || exit 1

ENTRYPOINT ["/bin/gluetun-dashboard"]
